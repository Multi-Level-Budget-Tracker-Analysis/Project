{
  "name": "MultiLevelBudgetTrackerTheme",
  "dataColors": [
    "#1F3864",
    "#C77F16",
    "#2E7D74",
    "#2B5B84",
    "#D97706",
    "#0D9488",
    "#4338CA",
    "#B45309",
    "#047857",
    "#475569"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F3864",
  "tableAccent": "#1F3864",
  "visualStyles": {
    "*": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#F8FAFC" } } }],
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#00000015" } }, "position": "Outer", "preset": "BottomRight" }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F3864" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "alignment": "Left" }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F3864" } }, "fontSize": 24, "fontFamily": "Segoe UI Bold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#64748B" } }, "fontSize": 10, "fontFamily": "Segoe UI" }]
      }
    }
  }
}
